__pycache__/

# Godot
project/.godot/
*.import
*.uid

# Test results
project/tests/results.xml

# ============================================================================
# REGENERABLE ARTIFACTS — NEVER COMMIT (see CLAUDE.md: "Generated artifacts")
#
# Every path below is produced by a script in this repo, and each one was
# committed at some point, which cost ~100 MB of history for files no reader
# ever needed. If you need one of them, run the command in the comment.
# ============================================================================

# Map exports (glTF/GLB): created by the export pipeline — the Export dialog,
# or `./run_tests.sh` (project/tests/test_pb_map_showcase.gd exports them).
project/exports/*
!project/exports/.gdignore

# The showcase map scene and the GLBs extracted from it: regenerated by the
# showcase-map test and by ./showcase_map.sh --export.
project/test_scenes/test_map_showcase.tscn
project/test_scenes/showcase_retro_baked*.glb
project/test_scenes/showcase_modern*.glb
project/test_scenes/showcase_*_albedo.png
project/test_scenes/showcase_retro_baked_*.png

# PSP homebrew binaries: built by retro_engine/psp/build_psp.sh (or
# ./run_psp.sh, which builds them when missing).
retro_engine/psp/EBOOT.PBP
retro_engine/psp/*.PBP
retro_engine/psp/*.prx
retro_engine/psp/PoiRetro_PSP.zip
retro_engine/psp/atlas0_L*.png
retro_engine/psp/pbm_load.log
retro_engine/psp/poi_app.log

# The showcase video: frames, segments and deliverables all live under
# showcase_video/out and bake/ (built by ./showcase_video/build.sh). The
# README embed is a GitHub user-attachment URL, not a file in the repo.
showcase_video/out/*
!showcase_video/out/.gitignore

# End-user docs site: SOURCES live in docs/site/ (pages, CSS, build.py) and
# docs/site/assets/ (screenshots + clips — COMMITTED since v0.9.132: the
# workflows build the site and the nightly bundle from them, and the showcase
# bake they were extracted from cannot run in CI. extract_media.py remains the
# local regeneration tool; re-commit whenever it produces better shots).
# Regenerated by ./docs/site/build.sh  (HTML -> docs/site/out) and
# ./docs/site/build.sh --bundle (copy into the addon folder for the
# distribution ZIP). Both outputs stay gitignored.
docs/site/out/
project/addons/poibuilder/docs-site/


# Raylib demo: the SOURCE is committed, only build output and the generated
# screenshot are ignored. (The raylib library itself is a system dependency and
# is not vendored; retro_engine/raylib/flake.nix provides a dev shell for it.)
retro_engine/raylib/raylib_runner
retro_engine/raylib/raylib_proof_of_concept.png

# PSP real-hardware profiling harness
retro_engine/psp/hwrun/
retro_engine/psp/poi_profile.txt
retro_engine/psp/poi_trace.txt
# headless benchmark captures: regenerated by run_psp_headless.sh every run
retro_engine/psp/screenshot_psp*.png
retro_engine/psp/screenshot_psp*.tga
retro_engine/psp/poiretro_psp_hwtest.prx
retro_engine/psp/poiretro_hwtest.PBP

# Modern-workflow probe assets (4k GLTFs, machine-local — do not commit)
project/test_scenes/modern_assets/
